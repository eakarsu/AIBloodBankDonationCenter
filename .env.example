NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-me
DB_NAME=bloodbank
DB_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=replace-with-openrouter-model
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
